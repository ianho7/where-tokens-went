{
  "name": "agent-audit",
  "version": "0.1.0",
  "private": true,
  "description": "Local deterministic usage audit for coding-agent Harness histories",
  "type": "commonjs",
  "bin": {
    "agent-audit": "bin/agent-audit"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/codex-inspect.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "install-skills": "node scripts/install-skills.js",
    "install-local": "npm run build && npm link && npm run install-skills"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "fzstd": "^0.1.1"
  }
}
