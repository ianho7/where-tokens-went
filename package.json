{
  "name": "where-tokens-went",
  "version": "0.1.0",
  "private": true,
  "description": "Local deterministic usage audit for coding-agent Harness histories",
  "type": "commonjs",
  "bin": {
    "where-tokens-went": "bin/where-tokens-went"
  },
  "scripts": {
    "build": "node scripts/build-echarts.js && tsc -p tsconfig.json",
    "test": "npm run package-skills && node --test tests/codex-inspect.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package-skills": "npm run build && node scripts/package-skills.js",
    "install-skills": "node scripts/install-skills.js",
    "install-local": "npm run package-skills && npm link && npm run install-skills"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "0.25.10",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "echarts": "5.6.0"
  }
}
